{
  "name": "yuantest-playwright-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "YuanTest Playwright monorepo (pnpm + Turborepo)",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=21.7.0"
  },
  "scripts": {
